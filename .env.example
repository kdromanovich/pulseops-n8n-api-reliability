PULSEOPS_METRICS_RETENTION_DAYS=14
PULSEOPS_SLO_TARGET_PERCENT=99.9
PULSEOPS_TELEGRAM_CHAT_ID=
PULSEOPS_JIRA_BASE_URL=
PULSEOPS_JIRA_PROJECT_KEY=
PULSEOPS_JIRA_ISSUE_TYPE=Task
PULSEOPS_JIRA_RESOLVE_TRANSITION_ID=
